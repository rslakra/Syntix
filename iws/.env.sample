# Copy to .env with `make init-env`. Read by the API (app/config.py) AND by docker-compose.
# Real environment variables override this file.

# --- Application -----------------------------------------------------------
# Also the name of the API's Docker container, so keep it a valid container name
# (letters, digits, "_", ".", "-"; lowercase by convention).
APP_NAME=syntix-iws
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8080
DEBUG=true
# 3000 = ews web app, 8081 = Expo web dev server of the ews React Native app.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8081,http://localhost:8081
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Docker stack (docker-compose.yml) ---------------------------------------
# Host folder for this project's persistent data: postgres/, recordings/ (and sqlite/).
# Used by the API AND docker-compose; "~" is expanded. Use `make` targets so compose gets the full path.
# The AI models are NOT stored here: they live in ZeroCloud's own DATA_DIR.
DATA_DIR=~/Downloads/Data/Syntix
# Postgres major version -> image pgvector/pgvector:pg<version> (15, 16, 17, 18 exist).
# Data is kept per version in DATA_DIR/postgres/pg<version>; switching versions starts an empty database.
POSTGRES_VERSION=18
# Optional full image override (e.g. a pinned tag such as pgvector/pgvector:0.8.1-pg18):
# POSTGRES_IMAGE=

# --- Database ------------------------------------------------------------------
# postgres = the Docker pgvector database (default). sqlite = file DB, vectors searched in Python.
DB_BACKEND=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=change-me
DB_USER=change-me
DB_PASSWORD=change-me
# Only used when DB_BACKEND=sqlite. Empty = $DATA_DIR/sqlite/app.db
# (with the DATA_DIR above: ~/Downloads/Data/Syntix/sqlite/app.db). A relative value is under DATA_DIR.
DB_PATH=

# --- Recording storage ---------------------------------------------------------
# Empty = $DATA_DIR/recordings (with the DATA_DIR above: ~/Downloads/Data/Syntix/recordings),
# the folder docker-compose mounts into the api container. A relative value is under DATA_DIR.
STORAGE_PATH=
MAX_UPLOAD_MB=1024

# --- AI providers (served by ZeroCloud: run `make start` in ZeroCloud first) ---------------
# openai_compatible = talk to the endpoints below; fake = deterministic offline stubs
AI_PROVIDER=openai_compatible

# These URLs are used when the API runs on the host (make start). ZeroCloud publishes
# Ollama on :11434 and speech-to-text on :8000 (OLLAMA_PORT / STT_PORT in ZeroCloud/.env).
# The model names must be in ZeroCloud/.env (LLM_MODELS, EMBEDDING_MODELS, STT_MODELS);
# `make check-models` verifies it.

# Speech-to-text (OpenAI-compatible /audio/transcriptions). STT_LANGUAGE empty = auto-detect.
STT_BASE_URL=http://localhost:8000/v1
STT_MODEL=Systran/faster-whisper-small
STT_API_KEY=not-needed
STT_LANGUAGE=
STT_TIMEOUT_SEC=1800

# Chat model for enrichment, summaries and answers.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SEC=300
# Transcripts longer than this are enriched/summarised in windows of this size
LLM_CONTEXT_CHARS=24000

# Embeddings. Empty base URL / key reuse the LLM_* values.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
# Must match the model's output size. Fixed when the index_chunks table is created.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# URLs used when the API runs in a container (make stack-up). Defaults: the ZeroCloud container
# names on the "zerocloud" Docker network. If ZeroCloud uses a native Ollama (it says so on
# `make start`), the container name does not exist: uncomment the host.docker.internal line.
# CONTAINER_LLM_BASE_URL=http://zerocloud-ollama:11434/v1
# CONTAINER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# CONTAINER_STT_BASE_URL=http://zerocloud-speech2text:8000/v1

# --- Indexing and question answering -------------------------------------------
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.0
QA_HISTORY_MESSAGES=6
